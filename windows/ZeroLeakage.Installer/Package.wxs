<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="ZeroLeakage"
           Manufacturer="ZeroLeakage"
           Version="$(var.ProductVersion)"
           UpgradeCode="4B691D49-42B9-40D2-AE6D-969D57D83A9E"
           Scope="perMachine"
           Compressed="yes">

    <!-- Upgrades remove the old version first (its ServiceControl stops and deletes the service),
         then the new version installs and starts it again. Guard's firewall rules are kept across upgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ZeroLeakage is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\ZeroLeakage.UI\Assets\ZeroLeakage.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://zeroleakage.app" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ZeroLeakage">
        <Directory Id="COREFOLDER" Name="Core" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="ZeroLeakage" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="CoreFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Full uninstall only (not an upgrade): the service, already stopped, removes every "ZeroLeakage Guard"
         firewall rule, restores Windows DNS if it had switched it, and deletes its ProgramData folder.
         Deferred + no impersonation = runs as LocalSystem. Failures never block the uninstall. -->
    <CustomAction Id="GuardCleanup" FileRef="CoreServiceExeFile" ExeCommand="--cleanup"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="GuardCleanup" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Classic install-directory wizard; dark-themed app takes over after first launch. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Brand artwork (regenerate with windows\tools\New-InstallerArt.ps1). -->
    <WixVariable Id="WixUIBannerBmp" Value="Art\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Art\Dialog.bmp" />

    <!-- Offer to launch ZeroLeakage on the final page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ZeroLeakage" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]ZeroLeakage.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>

  <!-- Every file from the self-contained `dotnet publish` of the desktop app (the Core\ service folder is separate). -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppPublishDir)\**">
        <Exclude Files="$(var.AppPublishDir)\Core\**" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- ZeroLeakage Core: Windows service (LocalSystem, automatic start) that runs Guard. -->
  <Fragment>
    <ComponentGroup Id="CoreFiles" Directory="COREFOLDER">
      <Files Include="$(var.AppPublishDir)\Core\**">
        <Exclude Files="$(var.AppPublishDir)\Core\ZeroLeakage.Core.exe" />
      </Files>
      <Component Id="CoreServiceExe" Guid="5E0C2B6A-1F4D-4C8E-9B57-3A2D7C9E41F0">
        <File Id="CoreServiceExeFile" Source="$(var.AppPublishDir)\Core\ZeroLeakage.Core.exe" KeyPath="yes" />
        <ServiceInstall Id="CoreServiceInstall"
                        Name="ZeroLeakageCore"
                        DisplayName="ZeroLeakage Core"
                        Description="ZeroLeakage Guard: blocks known-malicious IPs and brute-force attackers with Windows Firewall rules. Everything stays on this PC."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes" />
        <!-- Start on install; stop on install (upgrades/repairs) and uninstall; remove on uninstall. -->
        <ServiceControl Id="CoreServiceControl" Name="ZeroLeakageCore" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7C3A5E80-F831-4EA2-837C-68BCFB8E53D1">
        <Shortcut Id="StartMenuShortcutLink" Name="ZeroLeakage" Description="Zero-leak privacy shield"
                  Target="[INSTALLFOLDER]ZeroLeakage.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\ZeroLeakage" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
