<Application x:Class="ZeroLeakage.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeroLeakage.UI.ViewModels"
             xmlns:v="clr-namespace:ZeroLeakage.UI.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page view-model → view mapping for the shell's content host -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FirewallViewModel}"><v:FirewallView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DnsTelemetryViewModel}"><v:DnsTelemetryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeepScanViewModel}"><v:DeepScanView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
