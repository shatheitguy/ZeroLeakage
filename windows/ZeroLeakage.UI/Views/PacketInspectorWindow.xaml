<Window x:Class="ZeroLeakage.UI.Views.PacketInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZeroLeakage.UI.ViewModels"
        Title="ZeroLeakage — Packet inspector"
        Width="700" Height="780" MinWidth="520" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.UI}" Foreground="{StaticResource Brush.TextPrimary}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="130" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="16" BorderThickness="1" Background="#FA0D0F16" BorderBrush="{StaticResource Brush.BorderStrong}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header (drag to move) -->
            <Grid x:Name="Header" Margin="20,16,14,10" Background="Transparent" MouseLeftButtonDown="OnHeaderDown">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Foreground="{StaticResource Brush.Violet}" Text="PACKET INSPECTOR" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Button.Icon}" Click="OnClose" ToolTip="Close">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,14,0">
                <StackPanel Margin="0,0,6,6">
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Amber}" TextWrapping="Wrap"
                               Text="The Windows live feed runs on the simulated engine in this build. The DNS lookup, DNSSEC result, filter match and countries below are real." />

                    <!-- event -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="EVENT" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Verdict" /><TextBlock Style="{StaticResource Val}" Text="{Binding Verdict}" FontWeight="Bold" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Category" /><TextBlock Style="{StaticResource Val}" Text="{Binding Event.Category}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Time" /><TextBlock Style="{StaticResource Val}" Text="{Binding When}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Process" /><TextBlock Style="{StaticResource Val}" Text="{Binding Process}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Destination" /><TextBlock Style="{StaticResource Val}" Text="{Binding Destination}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Protocol" /><TextBlock Style="{StaticResource Val}" Text="{Binding Protocol}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Filter list" /><TextBlock Style="{StaticResource Val}" Text="{Binding RuleList}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Rule" /><TextBlock Style="{StaticResource Val}" Text="{Binding Rule}" Foreground="{StaticResource Brush.Violet}" /></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Key}" Text="Matched" /><TextBlock Style="{StaticResource Val}" Text="{Binding Matched}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- live lookup -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding IsDomain, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="LIVE DNS LOOKUP · SHIELD → RESOLVER" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Resolver" /><TextBlock Style="{StaticResource Val}" Text="{Binding ResolverText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Endpoint" /><TextBlock Style="{StaticResource Val}" Text="{Binding EndpointText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Transport" /><TextBlock Style="{StaticResource Val}" Text="{Binding TransportText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Round trip" /><TextBlock Style="{StaticResource Val}" Text="{Binding LatencyText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Query" /><TextBlock Style="{StaticResource Val}" Text="{Binding QueryText}" MaxWidth="460" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Status" /><TextBlock Style="{StaticResource Val}" Text="{Binding RcodeText}" FontWeight="Bold" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Response flags" /><TextBlock Style="{StaticResource Val}" Text="{Binding ResponseFlagsText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Style="{StaticResource Key}" Text="Sizes" /><TextBlock Style="{StaticResource Val}" Text="{Binding SizesText}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Key}" Text="DNSSEC" />
                                <Border x:Name="DnssecBadge" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="DnssecBadgeText" Style="{StaticResource Badge.Text}" Text="{Binding DnssecText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="130,0,0,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding DnssecExplain}" />
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Key}" Text="Extended error" /><TextBlock Style="{StaticResource Val}" Text="{Binding EdeText}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- answers -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="ANSWERS &amp; COUNTRY" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="No answer records." Visibility="{Binding Answers.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Answers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnswerRow}">
                                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{StaticResource Brush.VioletSoft}" BorderBrush="{StaticResource Brush.VioletLine}">
                                                    <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Violet}" Text="{Binding Type}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Data}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Ttl, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,3,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Location}"
                                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisible}}" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LocationNote}"
                                                               Visibility="{Binding LocationNote, Converter={StaticResource NotNullToVisible}}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Badge}" Background="{StaticResource Brush.MintSoft}" BorderBrush="{StaticResource Brush.MintLine}"
                                                        Visibility="{Binding HasCode, Converter={StaticResource BoolToVisible}}">
                                                    <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Mint}" Text="{Binding CountryCode}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Amber}" TextWrapping="Wrap" Text="{Binding GeoHint}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="Anycast networks (Cloudflare, Google, CDNs) can show the country the block is registered to rather than the server you actually reach." />
                        </StackPanel>
                    </Border>

                    <!-- hex -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding HasLookup, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="RAW BYTES (A QUERY / RESPONSE)" />
                            <Expander Header="Query hex" Foreground="{StaticResource Brush.TextSecondary}">
                                <TextBox Style="{StaticResource TextBox.Input}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Text="{Binding QueryHex, Mode=OneWay}" />
                            </Expander>
                            <Expander Margin="0,8,0,0" Header="Response hex" Foreground="{StaticResource Brush.TextSecondary}">
                                <TextBox Style="{StaticResource TextBox.Input}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Text="{Binding ResponseHex, Mode=OneWay}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="20,8,20,16">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                           Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,330,0" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Chip}" Content="Re-run lookup" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource Button.Chip}" Content="Copy report" Margin="0,0,6,0" Command="{Binding CopyCommand}" />
                    <Button Style="{StaticResource Button.Chip}" Content="Allow" Margin="0,0,6,0" Command="{Binding AllowCommand}" />
                    <Button Style="{StaticResource Button.Chip.Danger}" Content="Block" Command="{Binding BlockCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
