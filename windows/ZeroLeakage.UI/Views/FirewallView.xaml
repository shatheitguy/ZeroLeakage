<UserControl x:Class="ZeroLeakage.UI.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ZeroLeakage.UI.Models">
    <Grid Margin="8,10,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Firewall Rules" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}"
                           Text="Per-app network access, enforced by the ZeroLeakage_Core rule group. Flip a switch to cut an app off a network instantly." />
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource TextBox.Search}" Tag="Search apps or paths…"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Global kill-switches -->
        <UniformGrid Grid.Row="2" Columns="3">
            <UniformGrid.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Padding" Value="16,14" />
                </Style>
            </UniformGrid.Resources>
            <Border Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE701;" Foreground="{DynamicResource Brush.ModeAccent}" />
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Wi-Fi" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Global wireless kill-switch" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding WifiEnabled}" ToolTip="Allow Wi-Fi traffic" />
                </Grid>
            </Border>
            <Border Margin="7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE839;" Foreground="{DynamicResource Brush.ModeAccent}" />
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="LAN" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Local network &amp; file sharing" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding LanEnabled}" ToolTip="Allow LAN traffic" />
                </Grid>
            </Border>
            <Border Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE774;" Foreground="{DynamicResource Brush.ModeAccent}" />
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="WAN / Internet" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Everything beyond the router" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding WanEnabled}" ToolTip="Allow Internet traffic" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- App list -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,8,10">
                    <TextBlock Style="{StaticResource Text.Overline}" FontSize="11" Foreground="{StaticResource Brush.TextPrimary}" Text="APPLICATIONS" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                               Text="{Binding SummaryText}" />
                </Grid>
                <Grid Grid.Row="1" Margin="10,0,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="APPLICATION" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="SIGNATURE" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="BLOCKED" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="WI-FI" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="LAN" />
                    <TextBlock Grid.Column="6" Style="{StaticResource Text.Overline}" FontSize="9.5" Text="WAN" />
                </Grid>

                <ListBox Grid.Row="2" Style="{StaticResource ListBox.Clean}" ItemsSource="{Binding AppsView}"
                         ItemContainerStyle="{StaticResource ListBoxItem.Row}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:AppRule}">
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" HorizontalAlignment="Left" CornerRadius="10"
                                        Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                               FontWeight="Bold" FontSize="14" Text="{Binding Initial}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                                               Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>

                                <Border x:Name="Sig" Grid.Column="2" Style="{StaticResource Badge}" Margin="0,0,10,0">
                                    <TextBlock x:Name="SigText" Style="{StaticResource Badge.Text}" FontWeight="SemiBold"
                                               Text="{Binding SignatureText}" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Text.Mono}"
                                           Foreground="{StaticResource Brush.Crimson}" Text="{Binding BlockedAttempts, StringFormat=N0}" />

                                <ToggleButton Grid.Column="4" HorizontalAlignment="Left" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding WifiAllowed}" />
                                <ToggleButton Grid.Column="5" HorizontalAlignment="Left" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding LanAllowed}" />
                                <ToggleButton Grid.Column="6" HorizontalAlignment="Left" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding WanAllowed}" />

                                <Button x:Name="KillButton" Grid.Column="7" HorizontalAlignment="Right" Style="{StaticResource Button.Chip.Danger}"
                                        Padding="10,5" Content="Kill network"
                                        Command="{Binding DataContext.KillAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                    <Setter TargetName="Sig" Property="Background" Value="{StaticResource Brush.CrimsonSoft}" />
                                    <Setter TargetName="Sig" Property="BorderBrush" Value="{StaticResource Brush.CrimsonLine}" />
                                    <Setter TargetName="SigText" Property="Foreground" Value="{StaticResource Brush.Crimson}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFullyKilled}" Value="True">
                                    <Setter TargetName="KillButton" Property="Content" Value="Restore" />
                                    <Setter TargetName="KillButton" Property="Background" Value="{StaticResource Brush.MintSoft}" />
                                    <Setter TargetName="KillButton" Property="BorderBrush" Value="{StaticResource Brush.MintLine}" />
                                    <Setter TargetName="KillButton" Property="Foreground" Value="{StaticResource Brush.Mint}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
