<UserControl x:Class="ZeroLeakage.UI.Views.DeepScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ZeroLeakage.UI.Controls"
             xmlns:m="clr-namespace:ZeroLeakage.UI.Models">
    <Grid Margin="8,10,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="DeepScan AV" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}"
                       Text="Signature + heuristic engine with a real-time shield. Anything suspicious is sealed inside an AES-256 encrypted vault — it can never execute." />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- ═════ Scanner ═════ -->
            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Real-time shield" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Scans every file on open, write and execute" />
                        </StackPanel>
                        <ToggleButton HorizontalAlignment="Right" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding RealtimeEnabled}" />
                    </Grid>

                    <Grid Grid.Row="1" Width="210" Height="210" Margin="0,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Brush.ModeAccentFaint}" Margin="14" />
                        <ctl:ProgressRing Thickness="10" Value="{Binding Progress}" Stroke="{StaticResource Brush.Mint}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Metric}" FontSize="40" Text="{Binding ProgressText}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="{Binding ScanKindText}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="10.5"
                                   Foreground="{StaticResource Brush.TextMuted}" Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="FILES SCANNED" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="18" FontWeight="SemiBold" Text="{Binding FilesScannedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Inset}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="THREATS FOUND" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Crimson}"
                                           Text="{Binding ThreatsFound}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}">
                            <Button Style="{StaticResource Button.Mint}" Content="Quick scan" Margin="0,0,10,0" Command="{Binding QuickScanCommand}" />
                            <Button Style="{StaticResource Button.Outline}" Content="Full scan" Command="{Binding FullScanCommand}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Center" Style="{StaticResource Button.Danger}" Content="Cancel scan"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ═════ Encrypted quarantine vault ═════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,8,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE72E;" Foreground="{StaticResource Brush.Violet}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextPrimary}" Text="ENCRYPTED QUARANTINE VAULT" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Style="{StaticResource Badge}" Background="{StaticResource Brush.VioletSoft}" BorderBrush="{StaticResource Brush.VioletLine}">
                            <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Violet}" Text="AES-256-GCM" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Quarantine.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="34" Text="&#xE73E;" Foreground="{StaticResource Brush.Mint}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Subtitle}" Text="Vault is empty" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="No threats are being held." />
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource ListBox.Clean}" ItemsSource="{Binding Quarantine}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Row}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:QuarantineItem}">
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                        Background="{StaticResource Brush.Inset}" BorderBrush="{StaticResource Brush.Border}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Top">
                                            <Border CornerRadius="10" Background="{StaticResource Brush.CrimsonSoft}" />
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEBE8;" Foreground="{StaticResource Brush.Crimson}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="Bold" Foreground="{StaticResource Brush.Crimson}"
                                                       Text="{Binding ThreatName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                                                       Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}"
                                                       ToolTip="{Binding Sha256}">
                                                <Run Text="SHA-256 " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding ShortHash, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding DateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Chip}" Content="Restore" Margin="0,0,0,6"
                                                    Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Chip.Danger}" Content="Delete"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
