<UserControl x:Class="ZeroLeakage.UI.Views.DeepScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ZeroLeakage.UI.Controls"
             xmlns:svc="clr-namespace:ZeroLeakage.UI.Services">
    <Grid Margin="8,10,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="DeepScan AV" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                       Text="Powered by Microsoft Defender, the antivirus engine built into Windows. Every scan, detection and quarantine shown here comes straight from Defender." />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- ═════ Scanner ═════ -->
            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Real-time protection" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Managed by Microsoft Defender" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding RealtimeText}" />
                            </Border>
                            <Button Style="{StaticResource Button.Chip}" Content="Manage" Command="{Binding OpenRealtimeSettingsCommand}"
                                    ToolTip="Open Windows Security → Virus &amp; threat protection settings" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Width="210" Height="210" Margin="0,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Brush.ModeAccentFaint}" Margin="14" />
                        <ctl:ProgressRing Thickness="10" Value="100" IsIndeterminate="{Binding IsScanning}" Stroke="{StaticResource Brush.Mint}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Metric}" FontSize="40" Text="{Binding ProgressText}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Overline}" Text="{Binding ScanKindText}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap" />
                        <!-- Antivirus definitions (Microsoft Defender security intelligence) -->
                        <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0" Padding="12,9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="30" Height="30">
                                        <Border CornerRadius="9" Background="{StaticResource Brush.VioletSoft}" />
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="&#xE83D;" Foreground="{StaticResource Brush.Violet}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="Definitions " Foreground="{StaticResource Brush.TextSecondary}" /><Run Text="{Binding SignatureVersionText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding SignatureAgeText}" ToolTip="{Binding SignatureText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SignaturesStale}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Button.Chip}" VerticalAlignment="Center"
                                            Command="{Binding UpdateDefinitionsCommand}"
                                            ToolTip="Download the latest Microsoft Defender security intelligence now">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10.5" Text="&#xE896;" Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Margin="6,0,0,0" Text="Update definitions" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ProgressBar Margin="0,9,0,0" Style="{StaticResource ProgressBar.Thin}" IsIndeterminate="{Binding IsUpdatingDefinitions}"
                                             Visibility="{Binding IsUpdatingDefinitions, Converter={StaticResource BoolToVisible}}" />
                                <TextBlock Margin="40,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding DefinitionsStatus}"
                                           Visibility="{Binding DefinitionsStatus, Converter={StaticResource NotNullToVisible}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="LAST SCAN" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="13" FontWeight="SemiBold" Text="{Binding LastScanText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Inset}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="ACTIVE THREATS" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Crimson}"
                                           Text="{Binding ActiveThreats}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}">
                            <Button Style="{StaticResource Button.Mint}" Content="Quick scan" Margin="0,0,10,0" Command="{Binding QuickScanCommand}" />
                            <Button Style="{StaticResource Button.Outline}" Content="Full scan" Command="{Binding FullScanCommand}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Center" Style="{StaticResource Button.Danger}" Content="Cancel scan"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ═════ Defender threat history ═════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,8,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE72E;" Foreground="{StaticResource Brush.Violet}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextPrimary}" Text="THREAT HISTORY" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Chip.Danger}" Content="Remove active threats" Margin="0,0,6,0"
                                    Command="{Binding RemoveThreatsCommand}"
                                    Visibility="{Binding HasActiveThreats, Converter={StaticResource BoolToVisible}}" />
                            <Button Style="{StaticResource Button.Chip}" Content="Refresh" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource Button.Chip}" Content="Windows Security" Command="{Binding OpenSecurityCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Detections.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="34" Text="&#xE73E;" Foreground="{StaticResource Brush.Mint}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Subtitle}" Text="No threats detected" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Microsoft Defender has no detections on this PC." />
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource ListBox.Clean}" ItemsSource="{Binding Detections}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Row}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:DefenderDetection}">
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                        Background="{StaticResource Brush.Inset}" BorderBrush="{StaticResource Brush.Border}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Top">
                                            <Border CornerRadius="10" Background="{StaticResource Brush.CrimsonSoft}" />
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEBE8;" Foreground="{StaticResource Brush.Crimson}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="Bold" Foreground="{StaticResource Brush.Crimson}"
                                                       Text="{Binding ThreatName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                                                       Text="{Binding PrimaryResource}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryResource}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}">
                                                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource Brush.TextPrimary}" />
                                                <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding SeverityText, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding DateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Chip}" Content="Restore"
                                                    Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
