<UserControl x:Class="ZeroLeakage.UI.Views.DeepScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ZeroLeakage.UI.Controls"
             xmlns:svc="clr-namespace:ZeroLeakage.UI.Services">
    <Grid Margin="8,10,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="DeepScan AV" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                       Text="Microsoft Defender is your always-on shield. Add ClamAV as an on-demand second opinion. Every scan and detection here is real." />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- ═════ Scanner ═════ -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Engine picker -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="SCAN WITH" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                            <RadioButton Style="{StaticResource Radio.Chip}" Content="Defender" Margin="0,0,6,0" GroupName="engine"
                                         IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=Defender}" />
                            <RadioButton Style="{StaticResource Radio.Chip}" Content="ClamAV" Margin="0,0,6,0" GroupName="engine"
                                         IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=ClamAV}" />
                            <RadioButton Style="{StaticResource Radio.Chip}" Content="Both engines" GroupName="engine"
                                         IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=Both}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Radar -->
                    <ctl:ScanRadar Grid.Row="1" Width="230" Height="230" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsScanning="{Binding IsScanning}" Alert="{Binding HasActiveThreats}" Activity="{Binding FilesScanned}"
                                   CenterText="{Binding ProgressText}" CaptionText="{Binding ScanKindText}" />

                    <StackPanel Grid.Row="2">
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="10.5"
                                   Foreground="{StaticResource Brush.Mint}" Text="{Binding FilesScannedText}" />
                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="10"
                                   Foreground="{StaticResource Brush.TextMuted}" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                    </StackPanel>

                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,14,0,0">
                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="LAST DEFENDER SCAN" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="12.5" FontWeight="SemiBold" Text="{Binding LastScanText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Inset}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Overline}" Text="ACTIVE THREATS" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Crimson}"
                                           Text="{Binding ActiveThreats}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToCollapsed}}">
                            <Button Style="{StaticResource Button.Mint}" Content="Quick scan" Margin="0,0,8,0" Command="{Binding QuickScanCommand}" />
                            <Button Style="{StaticResource Button.Outline}" Content="Full scan" Margin="0,0,8,0" Command="{Binding FullScanCommand}" />
                            <Button Style="{StaticResource Button.Outline}" Command="{Binding ScanFolderCommand}" ToolTip="Scan a folder or USB drive">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE8B7;" />
                                    <TextBlock Margin="6,0,0,0" Text="Folder…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button HorizontalAlignment="Center" Style="{StaticResource Button.Danger}" Content="Cancel scan"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ═════ Engines + results ═════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Foreground="{StaticResource Brush.TextPrimary}" Text="ENGINES" />

                        <!-- Microsoft Defender -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32" VerticalAlignment="Top">
                                <Border CornerRadius="9" Background="{StaticResource Brush.MintSoft}" />
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE83D;" Foreground="{StaticResource Brush.Mint}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <Run Text="Microsoft Defender" /><Run Text="  · real-time " Foreground="{StaticResource Brush.TextMuted}" FontWeight="Normal" /><Run Text="{Binding RealtimeText, Mode=OneWay}" Foreground="{StaticResource Brush.Mint}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Definitions " /><Run Text="{Binding SignatureVersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SignatureAgeText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding DefinitionsStatus}"
                                           Visibility="{Binding DefinitionsStatus, Converter={StaticResource NotNullToVisible}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource Button.Chip}" Content="Update" Margin="0,0,6,0" Command="{Binding UpdateDefinitionsCommand}"
                                        ToolTip="Download the latest Microsoft Defender definitions now" />
                                <Button Style="{StaticResource Button.Chip}" Content="Manage" Command="{Binding OpenRealtimeSettingsCommand}"
                                        ToolTip="Windows Security → Virus &amp; threat protection settings" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="42,6,0,0" Style="{StaticResource ProgressBar.Thin}" IsIndeterminate="{Binding IsUpdatingDefinitions}"
                                     Visibility="{Binding IsUpdatingDefinitions, Converter={StaticResource BoolToVisible}}" />

                        <Border Margin="0,12" Height="1" Background="{StaticResource Brush.Border}" />

                        <!-- ClamAV -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32" VerticalAlignment="Top">
                                <Border CornerRadius="9" Background="{StaticResource Brush.VioletSoft}" />
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE721;" Foreground="{StaticResource Brush.Violet}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <Run Text="ClamAV" /><Run Text="  · on-demand second opinion" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Normal" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ClamVersionText}" ToolTip="{Binding ClamDbAgeText}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding ClamStatus}"
                                           Visibility="{Binding ClamStatus, Converter={StaticResource NotNullToVisible}}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Visibility="{Binding ClamNotInstalled, Converter={StaticResource BoolToVisible}}"
                                           Text="Open-source engine by Cisco Talos. Downloaded once (about 500 MB with signatures), then kept up to date daily. Scans when you ask." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource Button.Chip}" Content="Enable ClamAV" Command="{Binding EnableClamCommand}"
                                        Visibility="{Binding ClamNotInstalled, Converter={StaticResource BoolToVisible}}" />
                                <Button Style="{StaticResource Button.Chip}" Content="Update" Margin="0,0,6,0" Command="{Binding UpdateClamCommand}"
                                        Visibility="{Binding ClamInstalled, Converter={StaticResource BoolToVisible}}" ToolTip="Update the ClamAV engine and its signatures" />
                                <Button Style="{StaticResource Button.Chip.Danger}" Content="Remove" Command="{Binding RemoveClamCommand}"
                                        Visibility="{Binding ClamInstalled, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="42,6,0,0" Style="{StaticResource ProgressBar.Thin}" IsIndeterminate="{Binding ClamBusy}"
                                     Visibility="{Binding ClamBusy, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>

                <!-- Threats: Defender history + ZeroLeakage quarantine (ClamAV) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14,8,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,8,10">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Foreground="{StaticResource Brush.TextPrimary}" Text="THREATS &amp; QUARANTINE" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Chip.Danger}" Content="Remove Defender threats" Margin="0,0,6,0"
                                        Command="{Binding RemoveThreatsCommand}"
                                        Visibility="{Binding HasDefenderActiveThreats, Converter={StaticResource BoolToVisible}}" />
                                <Button Style="{StaticResource Button.Chip}" Content="Refresh" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                                <Button Style="{StaticResource Button.Chip}" Content="Windows Security" Command="{Binding OpenSecurityCommand}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding TotalItems, Converter={StaticResource ZeroToVisible}}">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="34" Text="&#xE73E;" Foreground="{StaticResource Brush.Mint}" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Subtitle}" Text="No threats detected" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Neither engine has anything on this PC." />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- ClamAV quarantine (ZeroLeakage vault) -->
                                <ItemsControl ItemsSource="{Binding Vault}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type svc:VaultItem}">
                                            <Border Margin="0,0,8,6" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                                    Background="{StaticResource Brush.Inset}" BorderBrush="{StaticResource Brush.Border}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="34" Height="34" VerticalAlignment="Top">
                                                        <Border CornerRadius="10" Background="{StaticResource Brush.CrimsonSoft}" />
                                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEBE8;" Foreground="{StaticResource Brush.Crimson}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="Bold" Foreground="{StaticResource Brush.Crimson}" Text="{Binding ThreatName}" />
                                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{StaticResource Brush.VioletSoft}">
                                                                <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Violet}" Text="CLAMAV" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}" ToolTip="{Binding Sha256}">
                                                            <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource Brush.TextPrimary}" />
                                                            <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                            <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding DateText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Button.Chip}" Content="Restore" Margin="0,0,0,6"
                                                                Command="{Binding DataContext.RestoreVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource Button.Chip.Danger}" Content="Delete"
                                                                Command="{Binding DataContext.DeleteVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Microsoft Defender threat history -->
                                <ItemsControl ItemsSource="{Binding Detections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type svc:DefenderDetection}">
                                            <Border Margin="0,0,8,6" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                                    Background="{StaticResource Brush.Inset}" BorderBrush="{StaticResource Brush.Border}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="34" Height="34" VerticalAlignment="Top">
                                                        <Border CornerRadius="10" Background="{StaticResource Brush.CrimsonSoft}" />
                                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEBE8;" Foreground="{StaticResource Brush.Crimson}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="Bold" Foreground="{StaticResource Brush.Crimson}" Text="{Binding ThreatName}" />
                                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{StaticResource Brush.MintSoft}">
                                                                <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Mint}" Text="DEFENDER" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,2,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                                                                   Text="{Binding PrimaryResource}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryResource}" />
                                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}">
                                                            <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource Brush.TextPrimary}" />
                                                            <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding SeverityText, Mode=OneWay}" />
                                                            <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}" /><Run Text="{Binding DateText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Button.Chip}" Content="Restore"
                                                                Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVisible}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
