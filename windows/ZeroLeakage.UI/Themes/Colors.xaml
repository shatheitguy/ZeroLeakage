<!--
    ZeroLeakage.UI — Colors.xaml
    Dark Glassmorphism / Cyber-Minimalist palette.

    Static palette keys are consumed with StaticResource.
    The *mode-reactive* keys (Brush.ModeAccent / Brush.ModeAccentSoft / Brush.ModeAccentFaint /
    Color.ModeAccent) are replaced at startup by ThemeManager with unfrozen brushes that animate
    between Mint / Violet / Crimson when the protection mode changes. ALWAYS consume those with
    DynamicResource — a StaticResource inside a Style setter would freeze the brush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Core surfaces ─────────────────────────────────────────────── -->
    <Color x:Key="Color.Canvas">#FF090A0F</Color>          <!-- Vantablack canvas -->
    <Color x:Key="Color.Rail">#FF0B0C12</Color>
    <Color x:Key="Color.Surface">#FF12151E</Color>         <!-- Frosted card surface -->
    <Color x:Key="Color.SurfaceTop">#FF151925</Color>
    <Color x:Key="Color.SurfaceRaised">#FF181C28</Color>
    <Color x:Key="Color.Inset">#FF0C0E14</Color>
    <Color x:Key="Color.Border">#FF1F2433</Color>          <!-- 1px card border -->
    <Color x:Key="Color.BorderStrong">#FF2A3145</Color>

    <!-- ── Accents ───────────────────────────────────────────────────── -->
    <Color x:Key="Color.Mint">#FF00F5A0</Color>            <!-- Zero-Leak Cyber Mint -->
    <Color x:Key="Color.Violet">#FF7B61FF</Color>          <!-- Electric Violet / Stealth -->
    <Color x:Key="Color.Crimson">#FFFF2E54</Color>         <!-- Neon Crimson / Lockdown -->
    <Color x:Key="Color.Amber">#FFFFB547</Color>           <!-- Warnings in the audit scorecard -->

    <!-- ── Text ──────────────────────────────────────────────────────── -->
    <Color x:Key="Color.TextPrimary">#FFF2F4F8</Color>
    <Color x:Key="Color.TextSecondary">#FF9AA3B5</Color>
    <Color x:Key="Color.TextMuted">#FF5C6478</Color>

    <!-- ── Solid brushes ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Rail" Color="{StaticResource Color.Rail}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Inset" Color="{StaticResource Color.Inset}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.Mint" Color="{StaticResource Color.Mint}" />
    <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}" />
    <SolidColorBrush x:Key="Brush.Crimson" Color="{StaticResource Color.Crimson}" />
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}" />

    <!-- Soft fills (≈14% alpha) and hairline borders (≈40% alpha) for badges & chips -->
    <SolidColorBrush x:Key="Brush.MintSoft" Color="#2400F5A0" />
    <SolidColorBrush x:Key="Brush.MintLine" Color="#6600F5A0" />
    <SolidColorBrush x:Key="Brush.VioletSoft" Color="#2B7B61FF" />
    <SolidColorBrush x:Key="Brush.VioletLine" Color="#807B61FF" />
    <SolidColorBrush x:Key="Brush.CrimsonSoft" Color="#26FF2E54" />
    <SolidColorBrush x:Key="Brush.CrimsonLine" Color="#73FF2E54" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#24FFB547" />
    <SolidColorBrush x:Key="Brush.AmberLine" Color="#66FFB547" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.Canvas}" />

    <SolidColorBrush x:Key="Brush.HoverWash" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#C7050609" />
    <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFE81123" />

    <!-- ── Frosted glass simulation (WPF has no native Mica/Acrylic on child surfaces) ── -->
    <LinearGradientBrush x:Key="Brush.CardGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2161A25" />
        <GradientStop Offset="0.55" Color="#F012151E" />
        <GradientStop Offset="1" Color="#F00F121A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.CardSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14FFFFFF" />
        <GradientStop Offset="0.18" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!-- Fades a 1px accent line in from both ends (used as OpacityMask). -->
    <LinearGradientBrush x:Key="Mask.HorizontalFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.5" Color="#FF000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <!-- Radial glow mask used for ambient accent blooms behind hero content. -->
    <RadialGradientBrush x:Key="Mask.RadialGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#FF000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </RadialGradientBrush>

    <!-- ── Mode-reactive placeholders (overridden by ThemeManager at runtime) ── -->
    <Color x:Key="Color.ModeAccent">#FF00F5A0</Color>
    <SolidColorBrush x:Key="Brush.ModeAccent" Color="#FF00F5A0" />
    <SolidColorBrush x:Key="Brush.ModeAccentSoft" Color="#2600F5A0" />
    <SolidColorBrush x:Key="Brush.ModeAccentFaint" Color="#1000F5A0" />

    <!-- ── Typography ────────────────────────────────────────────────── -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Display, Segoe UI Variable Text, Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">JetBrains Mono, Cascadia Code, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ── Geometry ──────────────────────────────────────────────────── -->
    <!-- Hexagon + "zero-drop" brand mark, drawn on a 24x24 grid. -->
    <Geometry x:Key="Geo.Hexagon">M12,1.2 L21.6,6.6 L21.6,17.4 L12,22.8 L2.4,17.4 L2.4,6.6 Z</Geometry>
    <Geometry x:Key="Geo.Drop">M12,6.4 C14.6,9.6 16.1,11.9 16.1,14.1 A4.1,4.1 0 0 1 7.9,14.1 C7.9,11.9 9.4,9.6 12,6.4 Z</Geometry>
    <Geometry x:Key="Geo.Slash">M8.4,18.4 L15.6,9.6</Geometry>

</ResourceDictionary>
