<UserControl x:Class="ZeroLeakage.UI.Controls.ModeSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ZeroLeakage.UI.Controls"
             Height="64">
    <Border CornerRadius="16" Background="#FF0B0D13" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="4">
        <Grid x:Name="Host">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sliding glowing indicator -->
            <Border x:Name="Indicator" Grid.ColumnSpan="3" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IndicatorShift" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="IndicatorGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>
            </Border>

            <Button x:Name="Seg1" Grid.Column="0" Style="{StaticResource Button.Ghost}" ctl:Ui.CornerRadius="12"
                    Padding="10,0" Click="OnSegmentClick" Tag="Balanced" AutomationProperties.Name="Mode 1 Balanced Shield">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold">
                        <Run x:Name="Num1" Text="01" /><Run Text=" // " Foreground="{StaticResource Brush.TextMuted}" /><Run x:Name="Lbl1" Text="BALANCED SHIELD" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                               Text="Telemetry &amp; trackers off" />
                </StackPanel>
            </Button>
            <Button x:Name="Seg2" Grid.Column="1" Style="{StaticResource Button.Ghost}" ctl:Ui.CornerRadius="12"
                    Padding="10,0" Click="OnSegmentClick" Tag="StrictGuard" AutomationProperties.Name="Mode 2 Strict Guard">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold">
                        <Run x:Name="Num2" Text="02" /><Run Text=" // " Foreground="{StaticResource Brush.TextMuted}" /><Run x:Name="Lbl2" Text="STRICT GUARD" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                               Text="Unknown apps must ask" />
                </StackPanel>
            </Button>
            <Button x:Name="Seg3" Grid.Column="2" Style="{StaticResource Button.Ghost}" ctl:Ui.CornerRadius="12"
                    Padding="10,0" Click="OnSegmentClick" Tag="TotalLockdown" AutomationProperties.Name="Mode 3 Total Zero-Leak">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold">
                        <Run x:Name="Num3" Text="03" /><Run Text=" // " Foreground="{StaticResource Brush.TextMuted}" /><Run x:Name="Lbl3" Text="TOTAL ZERO-LEAK" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}"
                               Text="Everything dropped" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
