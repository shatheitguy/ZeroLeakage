<UserControl x:Class="ZeroLeakage.UI.Controls.ShieldPulse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="140" IsHitTestVisible="False">
    <Grid>
        <Ellipse x:Name="Ring1" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="Scale1" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring2" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="Scale2" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring3" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="Scale3" /></Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Halo" Width="112" Height="112" />

        <Ellipse x:Name="Core" Width="86" Height="86" StrokeThickness="1.5" Fill="#FF0D1017" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Glyph" FontFamily="{StaticResource Font.Icons}" FontSize="28"
                       Text="&#xEA18;" HorizontalAlignment="Center" />
            <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="9.5" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextSecondary}" Text="0 BITS" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
