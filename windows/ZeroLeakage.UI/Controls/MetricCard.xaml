<UserControl x:Class="ZeroLeakage.UI.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Border Style="{StaticResource Card}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: icon tile + title, badge on the right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30">
                        <Border CornerRadius="9" Background="{Binding Accent, ElementName=Root}" Opacity="0.14" />
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14"
                                   Text="{Binding Glyph, ElementName=Root}" Foreground="{Binding Accent, ElementName=Root}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}"
                               Text="{Binding Title, ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" CornerRadius="6" Padding="6,2" BorderThickness="1"
                            BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Inset}">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{Binding Accent, ElementName=Root}" Text="{Binding Badge, ElementName=Root}" />
                    </Border>
                </Grid>

                <!-- Big value -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,6">
                    <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Value, ElementName=Root}" />
                    <TextBlock Margin="8,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource Text.Caption}"
                               FontSize="12" Text="{Binding Unit, ElementName=Root}" />
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="2">
                    <Rectangle Style="{StaticResource Divider}" VerticalAlignment="Top" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Caption, ElementName=Root}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontWeight="SemiBold"
                                   Foreground="{Binding Accent, ElementName=Root}" Text="{Binding SecondaryValue, ElementName=Root}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 1px accent glint along the top edge -->
        <Border Height="1" Margin="22,0" VerticalAlignment="Top" Background="{Binding Accent, ElementName=Root}"
                Opacity="0.7" OpacityMask="{StaticResource Mask.HorizontalFade}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
