<UserControl x:Class="ZeroLeakage.UI.Controls.ScanRadar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Viewbox>
        <Grid Width="220" Height="220">
            <!-- Soft glow behind everything (breathes when idle) -->
            <Ellipse x:Name="Glow" Margin="8" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowInner" Color="#3000F5A0" Offset="0" />
                        <GradientStop Color="#0000F5A0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Scope: disc, range rings, crosshair -->
            <Ellipse Margin="14" Fill="#FF0D1017" Stroke="#FF1F2433" StrokeThickness="1" />
            <Ellipse x:Name="Ring1" Margin="40" Stroke="#FF1F2433" StrokeThickness="1" StrokeDashArray="2 3" />
            <Ellipse x:Name="Ring2" Margin="66" Stroke="#FF1F2433" StrokeThickness="1" StrokeDashArray="2 3" />
            <Line X1="110" Y1="16" X2="110" Y2="204" Stroke="#FF1A1F2C" StrokeThickness="1" />
            <Line X1="16" Y1="110" X2="204" Y2="110" Stroke="#FF1A1F2C" StrokeThickness="1" />

            <!-- Pulse rings (scanning) -->
            <Ellipse x:Name="Pulse1" Margin="14" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="Pulse1Scale" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Pulse2" Margin="14" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="Pulse2Scale" /></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Rotating sweep: a fading wedge with a bright leading edge -->
            <Canvas x:Name="Sweep" Width="220" Height="220" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform x:Name="SweepRotate" /></Canvas.RenderTransform>
                <Path x:Name="Wedge" Data="M110,110 L110,14 A96,96 0 0 1 193.1,62 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="WedgeA" Color="#0000F5A0" Offset="0" />
                            <GradientStop x:Name="WedgeB" Color="#5500F5A0" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Line x:Name="Edge" X1="110" Y1="110" X2="193.1" Y2="62" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>

            <!-- Blips: where files are being checked -->
            <Canvas x:Name="Blips" Width="220" Height="220" IsHitTestVisible="False" />

            <!-- Outer progress / status ring -->
            <Ellipse x:Name="Outer" Margin="6" StrokeThickness="3" Opacity="0.9" />

            <!-- Centre readout -->
            <Ellipse Width="96" Height="96" Fill="#E60D1017" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Center" HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}" Text="{Binding CenterText, ElementName=Root}" />
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding CaptionText, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
