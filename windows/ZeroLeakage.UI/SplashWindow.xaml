<Window x:Class="ZeroLeakage.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroLeakage" Width="380" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Font.UI}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Card fades/lifts in -->
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Shield outline draws itself -->
                    <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="StrokeDashOffset" From="80" To="0" BeginTime="0:0:0.1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.75" Duration="0:0:0.3" />

                    <!-- Filled mark pops in -->
                    <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.5" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" BeginTime="0:0:0.5" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" BeginTime="0:0:0.5" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Wordmark -->
                    <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.75" Duration="0:0:0.35" />
                    <DoubleAnimation Storyboard.TargetName="WordsShift" Storyboard.TargetProperty="Y" From="8" To="0" BeginTime="0:0:0.75" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>

            <!-- Looping: sonar rings + scanning bar -->
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1.7" Duration="0:0:1.6" BeginTime="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.7" Duration="0:0:1.6" BeginTime="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.6" BeginTime="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1.7" Duration="0:0:1.6" BeginTime="0:0:1.4" />
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.7" Duration="0:0:1.6" BeginTime="0:0:1.4" />
                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.6" BeginTime="0:0:1.4" />
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="GliderShift" Storyboard.TargetProperty="X" From="-56" To="180" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Card" Margin="14" CornerRadius="24" Background="{StaticResource Brush.Canvas}"
            BorderBrush="#FF1F2433" BorderThickness="1" Opacity="0">
        <Border.RenderTransform><TranslateTransform x:Name="CardShift" /></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mark + sonar -->
            <Grid Width="150" Height="150" VerticalAlignment="Center" Margin="0,18,0,0">
                <Ellipse x:Name="Ring1" Width="110" Height="110" Stroke="#FF00F5A0" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ring2" Width="110" Height="110" Stroke="#FF7B61FF" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale" /></Ellipse.RenderTransform>
                </Ellipse>
                <Viewbox Width="84" Height="84">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Outline" Data="{StaticResource Geo.ShieldOutline}" Stroke="#FF00F5A0" StrokeThickness="0.8"
                              StrokeLineJoin="Round" StrokeDashArray="80 80" StrokeDashOffset="80" />
                        <Path x:Name="Mark" Data="{StaticResource Geo.ShieldMark}" Fill="#FF00F5A0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform x:Name="MarkScale" ScaleX="0.6" ScaleY="0.6" /></Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel x:Name="Words" Grid.Row="1" HorizontalAlignment="Center" Opacity="0">
                <StackPanel.RenderTransform><TranslateTransform x:Name="WordsShift" /></StackPanel.RenderTransform>
                <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="#FFEDEFF5">
                    <Run Text="Zero" /><Run Text="Leakage" FontWeight="Normal" Foreground="#FF8A90A2" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                           Foreground="#FF00F5A0" Text="ARMING SHIELD · ZERO BITS LEAKED" />
            </StackPanel>

            <!-- Scanning bar -->
            <Border Grid.Row="2" Width="180" Height="3" Margin="0,18,0,28" CornerRadius="2" Background="#FF1F2433" ClipToBounds="True">
                <Border Width="56" HorizontalAlignment="Left" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000F5A0" Offset="0" />
                            <GradientStop Color="#FF00F5A0" Offset="0.6" />
                            <GradientStop Color="#FF7B61FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform><TranslateTransform x:Name="GliderShift" X="-56" /></Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
