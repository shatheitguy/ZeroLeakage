<Window x:Class="ZeroLeakage.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ZeroLeakage.UI.Controls"
        xmlns:v="clr-namespace:ZeroLeakage.UI.Views"
        Title="ZeroLeakage"
        Width="1200" Height="760" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.UI}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Frameless: we draw our own title bar, DWM still provides snap, shadow & animations. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource Brush.Canvas}">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ambient mode-tinted bloom in the top-left corner -->
            <Ellipse Grid.RowSpan="2" Grid.ColumnSpan="2" Width="720" Height="520" Margin="-260,-280,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                     Fill="{DynamicResource Brush.ModeAccent}" Opacity="0.07" OpacityMask="{StaticResource Mask.RadialGlow}" />

            <!-- ═══════════════ Custom title bar ═══════════════ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Geo.ShieldMark}" Fill="{DynamicResource Brush.ModeAccent}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold">
                        <Run Text="Zero" /><Run Text="Leakage" Foreground="{DynamicResource Brush.ModeAccent}" />
                    </TextBlock>
                    <TextBlock Margin="10,1,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextMuted}" Text="{Binding VersionShort}" />
                </StackPanel>

                <!-- Live status pill — centred across the whole window -->
                <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="999" Padding="14,6" BorderThickness="1"
                        Background="#FF0F1219" BorderBrush="{DynamicResource Brush.ModeAccentSoft}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusHalo" Fill="{DynamicResource Brush.ModeAccent}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="StatusHaloScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.ModeAccent}" />
                        </Grid>
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.ModeAccent}" Text="ZERO BITS LEAKED" />
                        <Rectangle Width="1" Height="12" Margin="12,0" Fill="{StaticResource Brush.BorderStrong}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding ModeLabel}" />
                    </StackPanel>
                </Border>

                <!-- Quick actions + caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateWindowButton" WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleUpdateWindowCommand}" Padding="11,6" Margin="0,0,8,0"
                            ToolTip="Temporarily allow Windows Update traffic, then lock back down automatically">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Outline}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateWindowOpen}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.AmberSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberLine}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE896;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Text="{Binding UpdateWindowText}" />
                        </StackPanel>
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Outline}"
                            Command="{Binding RestoreDefaultsCommand}" Padding="11,6" Margin="0,0,14,0"
                            ToolTip="Remove all ZeroLeakage rules and return to Balanced Shield">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE777;" Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Margin="7,0,0,0" FontSize="11.5" Text="Restore Defaults" />
                        </StackPanel>
                    </Button>

                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption}"
                            Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption}"
                            Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption.Close}"
                            Content="&#xE8BB;" Click="OnClose" ToolTip="Hide to tray — protection keeps running" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Left icon rail ═══════════════ -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Style="{StaticResource ListBox.Clean}" Margin="0,12,0,0"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource ListBoxItem.Rail}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyboardNavigation.DirectionalNavigation="Cycle" />
                <!-- Profile / app menu: avatar with the busy ring around it -->
                <Grid Grid.Row="1" Margin="0,0,0,18" Width="48" Height="48" HorizontalAlignment="Center">
                    <ctl:ProgressRing Thickness="2" Value="100" IsIndeterminate="{Binding IsBusy}" IsHitTestVisible="False"
                                      Stroke="{DynamicResource Brush.ModeAccent}">
                        <ctl:ProgressRing.Style>
                            <Style TargetType="ctl:ProgressRing">
                                <Setter Property="Opacity" Value="0.28" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:ProgressRing.Style>
                    </ctl:ProgressRing>
                    <ToggleButton x:Name="AvatarButton" Style="{StaticResource Toggle.Avatar}"
                                  IsChecked="{Binding IsProfileMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ProfilePopup, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.Name="Profile and app menu" ToolTip="Profile, settings &amp; updates">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="16" Text="&#xE77B;" Foreground="{DynamicResource Brush.ModeAccent}" />
                    </ToggleButton>
                    <!-- Update-available dot -->
                    <Ellipse Width="11" Height="11" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="{StaticResource Brush.Amber}" Stroke="{StaticResource Brush.Canvas}" StrokeThickness="2"
                             IsHitTestVisible="False"
                             Visibility="{Binding HasUpdateBadge, Converter={StaticResource BoolToVisible}}" />

                    <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=AvatarButton}" Placement="Custom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsProfileMenuOpen, Mode=TwoWay}">
                        <Border Margin="16" Width="300" Padding="8" CornerRadius="14" BorderThickness="1"
                                Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}"
                                TextElement.FontFamily="{StaticResource Font.UI}" TextElement.Foreground="{StaticResource Brush.TextPrimary}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="8,8,8,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40">
                                        <Ellipse Fill="{DynamicResource Brush.ModeAccentSoft}" Stroke="{DynamicResource Brush.ModeAccent}" StrokeThickness="1" />
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="17" Text="&#xE77B;" Foreground="{DynamicResource Brush.ModeAccent}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Account.ProfileTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Text="{Binding Account.ProfileSubtitle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Account & sync: optional link to the user's own ZeroLeakage Server -->
                                <Button Style="{StaticResource Button.MenuItem}" Command="{Binding Account.OpenCommand}"
                                        ToolTip="Optional. ZeroLeakage works fully offline without a server.">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE895;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Account &amp; sync" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Account.MenuCaption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                Visibility="{Binding Account.IsLinked, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Style="{StaticResource Badge.Text}" FontSize="9.5" Text="LINKED" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <Rectangle Style="{StaticResource Divider}" Margin="6,6" />

                                <Button Style="{StaticResource Button.MenuItem}" Command="{Binding OpenSettingsCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE713;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Settings" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.MenuItem}" Command="{Binding UpdateDefinitionsCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE83D;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Update antivirus definitions" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DeepScan.SignatureAgeText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.MenuItem}" Command="{Binding CheckForUpdatesCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE777;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Check for updates" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Updates.StatusText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                Background="{StaticResource Brush.AmberSoft}" BorderBrush="{StaticResource Brush.AmberLine}"
                                                Visibility="{Binding HasUpdateBadge, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Style="{StaticResource Badge.Text}" FontSize="9.5" Foreground="{StaticResource Brush.Amber}" Text="NEW" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.MenuItem}" Command="{Binding OpenAboutCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE946;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="About ZeroLeakage" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontSize="10.5"
                                                   Foreground="{StaticResource Brush.TextMuted}" Text="{Binding VersionShort}" />
                                    </Grid>
                                </Button>

                                <Rectangle Style="{StaticResource Divider}" Margin="6,6" />

                                <Button Command="{Binding ExitCommand}" ToolTip="Close ZeroLeakage completely (same as Exit in the tray menu)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.MenuItem}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Crimson}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left" Text="&#xE7E8;"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Exit"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <!-- ═══════════════ Page host ═══════════════ -->
            <ctl:AnimatedContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" />

            <!-- ═══════════════ Snackbar ═══════════════ -->
            <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,26" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    CornerRadius="12" Padding="16,10" BorderThickness="1"
                    Background="#F2181C28" BorderBrush="{DynamicResource Brush.ModeAccentSoft}"
                    Visibility="{Binding Snackbar, Converter={StaticResource NotNullToVisible}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.ModeAccent}" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,14,0" VerticalAlignment="Center" FontSize="12.5" Text="{Binding Snackbar}" />
                    <Button Style="{StaticResource Button.Icon}" Width="22" Height="22" FontSize="9" Content="&#xE8BB;"
                            Command="{Binding DismissSnackbarCommand}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════ Post-install audit wizard (full screen below title bar) ═══════════════ -->
            <v:AuditWizardView Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Wizard}"
                               Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}" />

            <!-- ═══════════════ About ZeroLeakage ═══════════════ -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.Overlay}" DataContext="{Binding About}"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}">
                <Border Style="{StaticResource Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        Padding="26,22" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Brush.Inset}"
                                    BorderBrush="{DynamicResource Brush.ModeAccentSoft}" BorderThickness="1">
                                <Viewbox Width="30" Height="30">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Geo.ShieldMark}" Fill="{DynamicResource Brush.ModeAccent}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="SemiBold">
                                    <Run Text="Zero" /><Run Text="Leakage" Foreground="{DynamicResource Brush.ModeAccent}" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Mono}" FontSize="11.5"
                                           Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding VersionText}" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Button.Icon}" Content="&#xE8BB;" FontSize="11"
                                    Command="{Binding CloseCommand}" ToolTip="Close" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel>
                                <!-- App details -->
                                <TextBlock Style="{StaticResource Text.Overline}" Text="APP DETAILS" />
                                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Padding="14,8">
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" VerticalAlignment="Center"
                                                               Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Engine status (honest) -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Overline}" Text="ENGINE STATUS" />
                                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Padding="14,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource Brush.Amber}" />
                                            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Text="Firewall &amp; telemetry" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" FontSize="12" TextWrapping="Wrap" Text="{Binding EngineFirewallText}" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource Brush.Mint}" />
                                            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Text="DeepScan AV" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" FontSize="12" TextWrapping="Wrap" Text="{Binding EngineDefenderText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Updates -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Overline}" Text="UPDATES" />
                                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Padding="14,12" DataContext="{Binding Updates}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30">
                                                <Border CornerRadius="9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.ModeAccentSoft}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.AmberSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.CrimsonSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                                            <Setter Property="Text" Value="&#xE777;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.ModeAccent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE896;" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Crimson}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="Checks the latest release on GitHub. No personal data is sent." />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" VerticalAlignment="Center"
                                                    Content="{Binding InstallText}" Command="{Binding InstallCommand}"
                                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisible}}" />
                                        </Grid>
                                        <ProgressBar Margin="0,10,0,0" Style="{StaticResource ProgressBar.Thin}" IsIndeterminate="{Binding IsChecking}"
                                                     Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock Margin="42,10,0,0" Style="{StaticResource Text.Body}" FontSize="12" Text="{Binding ReleaseNotes}"
                                                   Visibility="{Binding ReleaseNotes, Converter={StaticResource NotNullToVisible}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Links -->
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Chip}" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding WebsiteUrl}" ToolTip="{Binding WebsiteUrl}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Text="&#xE774;" Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Margin="6,0,0,0" Text="Website" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Chip}" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding GitHubUrl}" ToolTip="{Binding GitHubUrl}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Text="&#xE943;" Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Margin="6,0,0,0" Text="GitHub" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Chip}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesUrl}" ToolTip="{Binding ReleasesUrl}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Text="&#xE8B7;" Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Margin="6,0,0,0" Text="Releases" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Button HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Content="Close" Command="{Binding CloseCommand}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Outline}" Margin="0,0,10,0" Command="{Binding CopyDetailsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE8C8;" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Margin="8,0,0,0" Text="Copy details" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding Updates.CheckCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE777;" Foreground="{StaticResource Brush.TextOnAccent}" />
                                        <TextBlock Margin="8,0,0,0" Text="Check for updates" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════ Account & sync ═══════════════ -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.Overlay}" DataContext="{Binding Account}"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}">
                <Border Style="{StaticResource Card}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        Padding="26,22" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Border CornerRadius="12" Background="{DynamicResource Brush.ModeAccentSoft}" />
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="18" Text="&#xE895;" Foreground="{DynamicResource Brush.ModeAccent}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="Account &amp; sync" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="Optional. Link this PC to your own ZeroLeakage Server so it follows your network's protection. Nothing goes to any third party." />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Button.Icon}" Content="&#xE8BB;" FontSize="11"
                                    Command="{Binding CloseCommand}" ToolTip="Close" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="470">
                            <StackPanel Margin="0,0,6,0">
                                <!-- ───── not linked: link form ───── -->
                                <StackPanel Visibility="{Binding IsNotLinked, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Radio.Chip}" GroupName="LinkHow" Content="Pairing code" Margin="0,0,6,0"
                                                     IsChecked="{Binding UsePairingCode}" />
                                        <RadioButton Style="{StaticResource Radio.Chip}" GroupName="LinkHow" Content="Sign in" IsChecked="{Binding UsePassword}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Overline}" Text="SERVER ADDRESS" />
                                    <TextBox Style="{StaticResource TextBox.Input}" Tag="https://zeroleakage.example.com"
                                             Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="2,6,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Amber}" TextWrapping="Wrap"
                                               Text="{Binding AddressWarning}" Visibility="{Binding AddressWarning, Converter={StaticResource NotNullToVisible}}" />

                                    <StackPanel Visibility="{Binding UsePairingCode, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Overline}" Text="PAIRING CODE" />
                                        <TextBox Style="{StaticResource TextBox.Input}" Tag="ZL-XXXX-XXXX" CharacterCasing="Upper"
                                                 Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="2,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Text="Create a code on your server's Devices page. Codes work once and expire quickly." />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding UsePassword, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Overline}" Text="USERNAME" />
                                        <TextBox Style="{StaticResource TextBox.Input}" Tag="your server username" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Overline}" Text="PASSWORD" />
                                        <PasswordBox x:Name="AccountPasswordBox" Style="{StaticResource PasswordBox.Input}" />
                                        <TextBlock Margin="2,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Text="Your password is sent once to your server and never stored. ZeroLeakage keeps only a device token, encrypted for your Windows account." />
                                    </StackPanel>

                                    <TextBlock Margin="2,12,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Crimson}" TextWrapping="Wrap"
                                               Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotNullToVisible}}" />
                                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Primary}" Content="Link this PC" Command="{Binding LinkCommand}" />
                                        <ProgressBar Margin="14,0,0,0" Width="120" Style="{StaticResource ProgressBar.Thin}" IsIndeterminate="{Binding IsBusy}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ───── linked: who, where, status ───── -->
                                <StackPanel Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="SIGNED IN" />
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Padding="14,8">
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style TargetType="Grid"><Setter Property="Margin" Value="0,4" /></Style>
                                            </StackPanel.Resources>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="User" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding SignedInAs}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="This device" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding DeviceName}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Server" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ServerName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ServerUrl, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                                                </TextBlock></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Last sync" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding LastSyncText}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Policy version" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding PolicyVersionText}" /></Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="2,8,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Crimson}" TextWrapping="Wrap"
                                               Text="{Binding SyncError}" Visibility="{Binding SyncError, Converter={StaticResource NotNullToVisible}}" />
                                    <TextBlock Margin="2,8,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Amber}" TextWrapping="Wrap"
                                               Text="{Binding Notice}" Visibility="{Binding Notice, Converter={StaticResource NotNullToVisible}}" />
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Outline}" Content="Sync now" Margin="0,0,10,0" Command="{Binding SyncNowCommand}" />
                                        <Button Style="{StaticResource Button.Danger}" Content="Unlink" Command="{Binding UnlinkCommand}" />
                                    </StackPanel>

                                    <!-- Server DNS (off by default) -->
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Use the server as this PC's DNS" />
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding ServerDnsText}" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource Toggle.Switch}"
                                                          IsChecked="{Binding UseServerDns}" IsEnabled="{Binding CanUseServerDns}" />
                                        </Grid>
                                    </Border>

                                    <!-- What the server manages -->
                                    <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Overline}" Text="YOUR NETWORK'S POLICY" />
                                    <TextBlock Margin="0,4,0,8" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                               Text="Items marked SET BY ADMIN are your network's baseline: they always apply and can't be switched off here. You can add stricter settings; they sync to your other devices only." />
                                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Filter lists set by admin" />
                                    <ItemsControl Margin="0,6,0,10" ItemsSource="{Binding LockedLists}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,6,6" Background="{StaticResource Brush.VioletSoft}" BorderBrush="{StaticResource Brush.VioletLine}">
                                                    <TextBlock Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Violet}" Text="{Binding Id, StringFormat={}{0} · SET BY ADMIN}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Blocked services" />
                                    <ItemsControl Margin="0,6,0,6" ItemsSource="{Binding Services}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Chip" Style="{StaticResource Badge}" Margin="0,0,6,6" Padding="8,2,2,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ChipText" Style="{StaticResource Badge.Text}" VerticalAlignment="Center" Text="{Binding Id}" />
                                                        <TextBlock x:Name="Lock" Margin="6,0,6,0" Style="{StaticResource Badge.Text}" FontSize="9" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Violet}" Text="SET BY ADMIN" Visibility="Collapsed" />
                                                        <Button x:Name="Remove" Style="{StaticResource Button.Icon}" Width="18" Height="18" FontSize="8" Content="&#xE8BB;"
                                                                ToolTip="Stop blocking (your own setting)"
                                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.VioletSoft}" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Brush.VioletLine}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Brush.Violet}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource TextBox.Input}" Tag="block another service (id from your server, e.g. tiktok)"
                                                 Text="{Binding ServiceInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Chip}" Content="Block" Command="{Binding AddServiceCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Blocked categories" />
                                    <ItemsControl Margin="0,6,0,10" ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                                                    <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding Id}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource Card.Inset}" Padding="14,8">
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style TargetType="Grid"><Setter Property="Margin" Value="0,3" /></Style>
                                            </StackPanel.Resources>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Safe search" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding SafeSearchText}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Block mode" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding BlockModeText}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Schedules" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding SchedulesText}" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12" Text="Guard" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontSize="11.5" Text="{Binding GuardPolicyText}" /></Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="2,8,0,0" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Amber}" TextWrapping="Wrap"
                                               Text="Your server has turned blocking off for this device (bypass)."
                                               Visibility="{Binding BypassBlocking, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Content="Close" Command="{Binding CloseCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════ Confirm dialog ═══════════════ -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.Overlay}"
                  Visibility="{Binding Confirm, Converter={StaticResource NotNullToVisible}}">
                <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24,22" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="34" Height="34">
                                <Border CornerRadius="10" Background="{StaticResource Brush.CrimsonSoft}" />
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{StaticResource Brush.Crimson}" />
                            </Grid>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Subtitle}" FontSize="17"
                                       Text="{Binding Confirm.Title}" />
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Body}" Text="{Binding Confirm.Message}" />
                        <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Outline}" Content="Cancel" Margin="0,0,10,0"
                                    Command="{Binding ConfirmCancelCommand}" IsCancel="True" />
                            <Button Style="{StaticResource Button.Danger}" Content="{Binding Confirm.ConfirmText}"
                                    Command="{Binding ConfirmAcceptCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
